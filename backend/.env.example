# =========================================================================
# PLATFORM AI
# Primary AI engine for intake analysis, scenario generation, and evaluation.
# =========================================================================
GEMINI_API_KEY=your_primary_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional additional Gemini keys for free-tier rotation and rate-limit recovery
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional OpenRouter / other OpenAI-compatible provider.
# Select it with PLATFORM_LLM_PROVIDER=openrouter.
OTHERAI_API_KEY=your_openrouter_api_key_here
OTHERAI_API_KEY_1=
OTHERAI_API_KEY_2=
OTHERAI_API_KEY_3=
OTHERAI_MODEL=openai/gpt-4o-mini
OTHERAI_BASE_URL=https://openrouter.ai/api/v1
PLATFORM_LLM_PROVIDER=gemini
PLATFORM_LLM_MODEL=

# =========================================================================
# PLATFORM-PROVIDED / TEST SERVICES
# Only configure services actually provided by the platform.
# =========================================================================
# Tavily API key for web search tools
TAVILY_API_KEY=your_tavily_search_api_key_here

# Separate Gemini API key used specifically for test agents compatible substitution
TEST_AGENT_GEMINI_API_KEY=your_test_agent_gemini_api_key_here

# Optional additional Gemini keys for test-agent free-tier rotation and rate-limit recovery
TEST_AGENT_GEMINI_API_KEY_1=
TEST_AGENT_GEMINI_API_KEY_2=
TEST_AGENT_GEMINI_API_KEY_3=

# =========================================================================
# BACKEND
# Relational database persistence store.
# If unset, the backend falls back automatically to in-memory store.
# =========================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# =========================================================================
# APPLICATION SETTINGS
# =========================================================================
PORT=8000
ENVIRONMENT=development
