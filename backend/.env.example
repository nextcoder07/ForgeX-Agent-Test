# =========================================================================
# 1. PLATFORM PRIMARY AI CREDENTIALS (Shared Cloud Rotation Pool)
# Powers ForgeX's 4 core operational stage roles:
# (1. INTAKE_ANALYST, 2. SCENARIO_PLANNER, 3. EXECUTION_OBSERVER, 4. IMPROVEMENT_ANALYST)
# Supported provider names: gemini | openrouter | openai | anthropic | groq
# =========================================================================
AI_API_KEY_1=your_ai_api_key_1_here
AI_API_NAME_1=gemini
AI_MODEL_1=gemini-3.6-flash

AI_API_KEY_2=your_ai_api_key_2_here
AI_API_NAME_2=gemini
AI_MODEL_2=gemini-3.6-flash

# =========================================================================
# 2. INDEPENDENT META-EVALUATOR (API Key Rotation Pool + Local Ollama Fallback)
# Evaluates ForgeX stage quality; isolated from the models being evaluated.
# Supports cloud key rotation (META_EVALUATOR_API_KEY_1..N) and automatic local fallback.
# =========================================================================
META_EVALUATOR_API_KEY_1=your_meta_evaluator_key_1_here
META_EVALUATOR_PROVIDER_1=gemini
META_EVALUATOR_MODEL_1=gemini-3.6-flash

META_EVALUATOR_API_KEY_2=your_meta_evaluator_key_2_here
META_EVALUATOR_PROVIDER_2=gemini
META_EVALUATOR_MODEL_2=gemini-3.6-flash

# Meta-Evaluator Dedicated Local Fallback (Isolated LoRA/SFT Judge Model)
META_EVALUATOR_OLLAMA_MODEL=qwen2.5-coder:7b
META_EVALUATOR_ADAPTER=forgeX-meta-evaluator-v1

# =========================================================================
# 3. STAGE-SPECIFIC DEDICATED LOCAL FALLBACK MODELS (Trainable via SFT / LoRA)
# Each platform stage binds to an isolated logical connection for targeted fine-tuning.
# A single base Qwen model is specialized per stage via dedicated LoRA adapters.
# =========================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Stage 1: Intake & Behavioral AST Extraction
OLLAMA_INTAKE_MODEL=qwen2.5-coder:7b
OLLAMA_INTAKE_ADAPTER=forgeX-intake-v2

# Stage 2: Scenario Intelligence & Test Planning
OLLAMA_SCENARIO_MODEL=qwen2.5-coder:7b
OLLAMA_SCENARIO_ADAPTER=forgeX-scenario-v2

# Stage 3: Sandbox Trajectory & Decision Observer
OLLAMA_OBSERVER_MODEL=qwen2.5-coder:7b
OLLAMA_OBSERVER_ADAPTER=forgeX-observer-v2

# Stage 4: Diagnosis & Code Repair Patch Generator
OLLAMA_REPAIR_MODEL=qwen2.5-coder:7b
OLLAMA_REPAIR_ADAPTER=forgeX-repair-v2


# =========================================================================
# 4. USER/TEST AGENT SANDBOX EXECUTION POOL (For sandboxed test agent processes)
# Isolated from platform internals; used only by the test agents under evaluation.
# =========================================================================
TEST_AI_API_KEY_1=your_test_agent_key_here
TEST_AI_API_NAME_1=gemini
TEST_AI_MODEL_1=gemini-3.6-flash

# =========================================================================
# 5. OPTIONAL EXTERNAL SERVICES & PERSISTENCE
# =========================================================================
TAVILY_API_KEY=your_tavily_search_api_key_here

# Optional Supabase (Falls back to local file store automatically)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# =========================================================================
# 6. APPLICATION SERVER CONFIGURATION
# =========================================================================
PORT=8000
ENVIRONMENT=development

