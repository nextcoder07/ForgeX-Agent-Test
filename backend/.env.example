# =========================================================================
# 1. PLATFORM EVALUATION LLM REGISTRY (Sequence Priority Rotation)
# Platform Intake, Scenario Generator, Adversarial Critic, and Evaluation Judge
# Supported providers: gemini | openrouter | ollama
# =========================================================================
AI_API_KEY_1=your_primary_google_gemini_api_key
AI_API_NAME_1=gemini
AI_MODEL_1=gemini-3.6-flash

AI_API_KEY_2=your_secondary_google_gemini_api_key
AI_API_NAME_2=gemini
AI_MODEL_2=gemini-3.6-flash

AI_API_KEY_3=your_openrouter_api_key
AI_API_NAME_3=openrouter
AI_MODEL_3=openai/gpt-4o-mini

AI_API_KEY_4=http://localhost:11434
AI_API_NAME_4=ollama
AI_MODEL_4=llama3.2

# =========================================================================
# 2. TEST AGENT SANDBOX EXECUTION POOL (Sequence Priority Rotation)
# Dedicated keys automatically mapped into sandboxed child processes as:
# OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY, etc.
# =========================================================================
TEST_AI_API_KEY_1=your_test_agent_openrouter_key
TEST_AI_API_NAME_1=openrouter
TEST_AI_MODEL_1=openai/gpt-4o-mini

TEST_AI_API_KEY_2=your_test_agent_gemini_key
TEST_AI_API_NAME_2=gemini
TEST_AI_MODEL_2=gemini-3.6-flash

# =========================================================================
# 3. LOCAL OLLAMA HOST ENDPOINT (Optional Hybrid Fallback)
# =========================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# =========================================================================
# 4. PLATFORM SEARCH & EXTERNAL SERVICE INTEGRATIONS (Optional)
# =========================================================================
TAVILY_API_KEY=your_tavily_search_api_key_here
SERPER_API_KEY=your_serper_search_api_key_here

# =========================================================================
# 5. DATABASE & PERSISTENCE STORE (Supabase)
# Fallback to local disk snapshots if tables are not created.
# =========================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =========================================================================
# 6. APPLICATION SERVER CONFIGURATION
# =========================================================================
PORT=8000
ENVIRONMENT=development
