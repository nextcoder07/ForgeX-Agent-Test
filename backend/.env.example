# Google Gemini configuration (optional; fallback mode works without a key)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Additional Gemini API Keys for automatic rotation (Gemini Key 2, Gemini Key 3, etc.)
GEMINI_API_KEY_1=AIzaSy_second_key_here
GEMINI_API_KEY_2=AIzaSy_third_key_here
GEMINI_API_KEY_3=
# Supabase persistence (optional; in-memory fallback is used when unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Application settings
PORT=8000
ENVIRONMENT=development

# Optional demo-agent dependency
NEWS_API_KEY=your_news_api_key_here
